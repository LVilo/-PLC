<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             xmlns:vm="using:APM_PLC.ViewModels.DialogViewModels"
             x:DataType="vm:ParamCNV127DialogViewModel"
             x:Class="APM_PLC.Views.DialogViews.ParamCNV127DialogView"
             Foreground="Black"
             Width="400"
             Height="350">


  <Design.DataContext>
      <vm:ParamCNV127DialogViewModel/>
  </Design.DataContext>

    <Border Background="{DynamicResource PrimaryColorBackgroundBorder}" CornerRadius="20" ClipToBounds="True" Margin="10">
		<StackPanel>

            <!--Заголовок-->
			<Border Background="LightGray" >
				<TextBlock
                Text="{Binding Title}"
                Padding="10"
                FontSize="18"
                FontWeight="Bold"/>
            </Border>

            <Border Padding="10">
                <StackPanel Spacing="30">
                    <!-- Текст-->
					<StackPanel Orientation="Horizontal">
                    <TextBlock Text="Запишите прараметры согласно заказу"
                               TextWrapping="Wrap"
                               MaxWidth="300"/>
                </StackPanel>

                    <!--Тело-->
                    <StackPanel Spacing="5" >
						<Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10"
                          ColumnSpacing="5"
                          Classes="Param">
						<TextBlock Text="{Binding Readed}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="0"/>
                            <TextBox Text="{Binding ReadedType}" Grid.Column="1" Grid.Row="0" IsEnabled="False" />
                            <TextBlock Text="{Binding Write}" Margin="0,5,0,0" Grid.Column="2" Grid.Row="0"/>
                            <ComboBox ItemsSource="{Binding SourceType}" Grid.Column="3" Grid.Row="0" SelectedItem="{Binding SelectrdeType}"/>

                        <TextBlock Text="{Binding Filter_H}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="1"/>
                            <TextBox Text="{Binding Filter_H_Result}" Grid.Column="1" Grid.Row="1" TextChanged="FilterText"/>
                            <TextBlock Text="{Binding Filter_L}" Margin="0,5,0,0" Grid.Column="2" Grid.Row="1"/>
                            <TextBox Text="{Binding Filter_L_Result}" Grid.Column="3" Grid.Row="1" TextChanged="FilterText"/>

                        <TextBlock Text="{Binding L_1_I}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="2"/>
                            <TextBox Text="{Binding L_1_I_Result}" Grid.Column="1" Grid.Row="2" TextChanged="FilterText"/>
                            <TextBlock Text="{Binding H_1_I}" Margin="0,5,0,0" Grid.Column="2" Grid.Row="2"/>
                            <TextBox Text="{Binding H_1_I_Result}" Grid.Column="3" Grid.Row="2" TextChanged="FilterText"/>

                            <TextBlock Text="{Binding L_2_I}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="3"/>
                            <TextBox Text="{Binding L_2_I_Result}" Grid.Column="1" Grid.Row="3" TextChanged="FilterText"/>
                            <TextBlock Text="{Binding H_2_I}" Margin="0,5,0,0" Grid.Column="2" Grid.Row="3"/>
                            <TextBox Text="{Binding H_2_I_Result}" Grid.Column="3" Grid.Row="3" TextChanged="FilterText"/>

                    </Grid>
                    </StackPanel>

                    <!--Кнопки-->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
						<Button Content="{Binding ConfirmText}"
                            Command="{Binding ConfirmCommand}"/>

                    <Button Content="{Binding CancelText}"
                            Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
