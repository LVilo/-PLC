<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:APM_PLC.ViewModels.DialogViewModels"
             x:DataType="vm:ParamCapacityDialogViewModel"
             x:Class="APM_PLC.Views.DialogViews.ParamCapacityDialogView"
             Foreground="Black"
             Width="360"
             Height="230">


  <Design.DataContext>
      <vm:ParamCapacityDialogViewModel/>
  </Design.DataContext>

    <Border Background="{DynamicResource PrimaryColorBackgroundBorder}" CornerRadius="20" ClipToBounds="True" Margin="10">
		<StackPanel>

            <!--Заголовок-->
			<Border Background="LightGray" >
				<TextBlock
                Text="{Binding Title}"
                Padding="10"
                FontSize="18"
                FontWeight="Bold"/>
            </Border>

            <Border Padding="10">
                <StackPanel Spacing="30">
                    <!-- Текст-->
					<StackPanel Orientation="Horizontal">
                    <TextBlock Text="Запишите прараметры согласно заказу"
                               TextWrapping="Wrap"
                               MaxWidth="300"/>
                </StackPanel>

                    <!--Тело-->
                    <StackPanel Spacing="5">
						<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowDefinitions="Auto"
                          RowSpacing="10"
                          ColumnSpacing="5"
                          Classes="Param">
							<TextBlock Text="{Binding C1Text}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="0"/>
                            <TextBox Text="{Binding C1}" Grid.Column="1" Grid.Row="0" MaxWidth="60" TextChanged="FilterText"/>
                            <TextBlock Text="{Binding C2Text}" Margin="0,5,0,0" Grid.Column="2" Grid.Row="0"/>
                            <TextBox Text="{Binding C2}" Grid.Column="3" Grid.Row="0" MaxWidth="60" TextChanged="FilterText"/>
                            <TextBlock Text="{Binding ResultText}" Margin="0,5,0,0" Grid.Column="4" Grid.Row="0"/>
                            <TextBlock Text="{Binding C_Result}" Grid.Column="5" Grid.Row="0" Margin="0,5,0,0"
                                     MaxWidth="60"/>
                        </Grid>
                    </StackPanel>

                    <!--Кнопки-->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
						<Button Content="{Binding ConfirmText}"
                            Command="{Binding ConfirmCommand}"/>

                    <Button Content="{Binding CancelText}"
                            Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
