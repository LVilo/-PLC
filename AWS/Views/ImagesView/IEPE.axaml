<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AWS.IEPE"
        Title="IEPE"
        Width="400"
        Height="300">
 <StackPanel Name="Dialog_Panel">
		<Border 
                BorderBrush="Black"
                BorderThickness="2"
                Margin="5">
			<Image Name="Image_Panel"
                   Stretch="Uniform"/>
		</Border>
     <StackPanel 
                 Margin="5">
         <Label 
                HorizontalAlignment="Center"
                Margin="10"/>
		 <Grid ColumnDefinitions="150,150,150"
         HorizontalAlignment="Center">
			     <Button Grid.Column="0" Content="Остановить" HorizontalContentAlignment="Center"
                HorizontalAlignment="Left" Width="100"/>
                 <Button Grid.Column="1" Content="ОК" HorizontalContentAlignment="Center"
                         HorizontalAlignment="Center" Width="100"/>
                 <Button Grid.Column="2" Content="Пропустить" HorizontalContentAlignment="Center"
                         HorizontalAlignment="Right" Width="100"/>
         </Grid>
     </StackPanel>
     
	</StackPanel>
</Window>
