<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
		Width="400" Height="300"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        x:Class="AWS.Dialog"
        Title="Dialog"
		CanResize="False">
	<StackPanel Name="Dialog_Panel">
		<Border Name="Border_Name"
                BorderBrush="Black"
                BorderThickness="2"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
			<Image Name="Image_Panel"
                   Stretch="Uniform"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"/>
		</Border>
		<StackPanel  Background="LightGray" Height="124">
			<TextBlock Name="Label_Text" Margin="10" Width="300" TextWrapping="Wrap"/>
			<Grid ColumnDefinitions="100,100,100" HorizontalAlignment="Center" VerticalAlignment="Bottom">
				
				<Button Name="OK" Click="OK_Click" Grid.Column="0" Content="Ок"
			HorizontalContentAlignment="Center"  Background="#1DEC1D" HorizontalAlignment="Left" Width="100" Margin="5"/>
				
				<Button Name="Skip" Click="Skip_Click" Grid.Column="1" Content="Пропустить"
			HorizontalContentAlignment="Center" HorizontalAlignment="Center" Width="100" Margin="5"/>
				
				<Button Name="Cancel" Click="Canel_Click" Grid.Column="2" Content="Отмена"
				HorizontalContentAlignment="Center" HorizontalAlignment="Right" Background="#FF0000" Width="100" Margin="5"/>
				
			</Grid>
		</StackPanel>

	</StackPanel>
</Window>
