<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
	  <InvariantGlobalization>true</InvariantGlobalization>
	  <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\4_20Input.png" />
    <None Remove="Images\4_20Output.png" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="Images\4_20Input.png" />
	<EmbeddedResource Include="Images\4_20Output.png" />
	<EmbeddedResource Include="Images\IEPE.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.7" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.7" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EasyModbus">
      <HintPath>..\..\..\AutoSet_New\AutoSet\EasyModbus.dll</HintPath>
    </Reference>
    <Reference Include="NationalInstruments.Visa">
      <HintPath>..\..\..\AutoSet_New\AutoSet\NationalInstruments.Visa.dll</HintPath>
    </Reference>
    <Reference Include="PortsWork">
      <HintPath>Libs\PortsWork.dll</HintPath>
    </Reference>
    <Reference Include="usbGenericHidCommunications">
      <HintPath>..\..\..\AutoSet_New\AutoSet\usbGenericHidCommunications.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
